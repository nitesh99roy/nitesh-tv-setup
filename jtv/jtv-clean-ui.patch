index 0000000..ac2d401
--- /dev/null
+++ b/android/app/src/test/java/com/fenyx/jtv/ui/main/PreviewRenderTest.kt
@@ -0,0 +1,231 @@
+package com.fenyx.jtv.ui.main
+
+import android.graphics.Bitmap
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.itemsIndexed
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.focus.focusRequester
+import androidx.compose.ui.graphics.asAndroidBitmap
+import androidx.compose.ui.test.captureToImage
+import androidx.compose.ui.test.junit4.createComposeRule
+import androidx.compose.ui.test.onRoot
+import androidx.compose.ui.test.onNodeWithText
+import androidx.compose.ui.test.requestFocus
+import androidx.compose.ui.unit.dp
+import com.fenyx.jtv.data.Channel
+import com.fenyx.jtv.data.EpgProgram
+import com.fenyx.jtv.theme.FormFactor
+import com.fenyx.jtv.theme.JioTVGoTVTheme
+import com.fenyx.jtv.ui.components.LocalNow
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+import java.io.File
+
+/**
+ * LOCAL PREVIEW (not upstream): draws TV screens on the PC with sample channels and saves PNGs to
+ * app/build/previews, so a design can be judged before anything goes to the TV.
+ * Run: gradlew :app:testDebugUnitTest --tests "*PreviewRenderTest*"
+ * 960x540dp at xhdpi = a 1080p TV (and the same dp size as a 720p TV).
+ */
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+@Config(sdk = [35], qualifiers = "w960dp-h540dp-land-xhdpi", application = android.app.Application::class)
+class PreviewRenderTest {
+
+    @get:Rule val rule = createComposeRule()
+
+    private val now = 1_760_000_000_000L // fixed clock so renders are repeatable
+    private val min = 60_000L
+
+    private val channels = listOf(
+        Channel("1", "Aaj Tak HD", "", "News", "", channelNumber = 101, language = "Hindi"),
+        Channel("2", "Star Sports 1 HD", "", "Sports", "", channelNumber = 405, language = "English"),
+        Channel("3", "Colors HD", "", "Entertainment", "", channelNumber = 152, language = "Hindi"),
+        Channel("4", "Sony SAB HD", "", "Entertainment", "", channelNumber = 158, language = "Hindi"),
+        Channel("5", "Discovery HD", "", "Infotainment", "", channelNumber = 520, language = "English"),
+        Channel("6", "NDTV 24x7", "", "News", "", channelNumber = 108, language = "English"),
+        Channel("7", "Zee Cinema HD", "", "Movies", "", channelNumber = 302, language = "Hindi"),
+        Channel("8", "Nick", "", "Kids", "", channelNumber = 601, language = "Hindi"),
+    )
+
+    private fun show(title: String, startMin: Int, lenMin: Int, desc: String = "") =
+        EpgProgram(title, desc, now + startMin * min, now + (startMin + lenMin) * min)
+
+    private val nowShows = listOf(
+        show("Dangal", -40, 60, "Prime-time debate on the day's biggest story."),
+        show("India vs Australia, 3rd ODI", -95, 240, "Live from Wankhede Stadium, Mumbai. India need 112 off 90 balls."),
+        show("Bigg Boss", -10, 60),
+        show("Taarak Mehta Ka Ooltah Chashmah", -27, 30),
+        show("How It's Made", -12, 30),
+        show("The Big Fight", -20, 60),
+        show("Gadar 2", -70, 170),
+        show("Motu Patlu", -3, 25),
+    )
+
+    private val categories = listOf(
+        Category("fav", "Favourites", 12),
+        Category("all", "All channels", 846),
+        Category("news", "News", 142),
+        Category("sports", "Sports", 34),
+        Category("ent", "Entertainment", 118),
+        Category("movies", "Movies", 61),
+        Category("kids", "Kids", 27),
+        Category("music", "Music", 40),
+        Category("info", "Infotainment", 22),
+    )
+
+    /** The row to show focused; requested once the list has laid out its items. */
+    private val focus = FocusRequester()
+
+    @Composable
+    private fun TvHome() {
+        CompositionLocalProvider(LocalNow provides now) {
+            JioTVGoTVTheme(form = FormFactor.Tv) {
+                androidx.compose.foundation.layout.Box(
+                    androidx.compose.ui.Modifier.fillMaxSize().background(com.fenyx.jtv.theme.Jtv.colors.bg),
+                ) {
+                    WideHome(
+                        categories = categories, selected = "all", count = 846, onSelect = {}, selectOnFocus = false,
+                        onSearch = {}, onGuide = {}, onSettings = {},
+                        movingName = null, movingPos = 0, total = 846,
+                        list = {
+                            LazyColumn(verticalArrangement = Arrangement.spacedBy(2.dp)) {
+                                itemsIndexed(channels) { i, ch ->
+                                    ChannelRow(
+                                        ch, nowShows[i], now, TvRow, isFavorite = i == 0 || i == 3, isMoving = false,
+                                        onClick = {}, onLongClick = {},
+                                        modifier = if (i == 1) Modifier.focusRequester(focus) else Modifier,
+                                    )
+                                }
+                            }
+                        },
+                        preview = {
+                            PreviewPane(
+                                channels[1],
+                                listOf(nowShows[1], show("Post-match show", 145, 30), show("Cricket Live: Highlights", 175, 60), show("Inside Out", 235, 30)),
+                                now, channels[1].channelNumber, isFavorite = false,
+                                onWatch = {}, onFavorite = {}, onOptions = {},
+                            )
+                        },
+                    )
+                }
+            }
+        }
+        // A TV remote puts Compose in keyboard input mode; only then is D-pad focus drawn.
+        val inputMode = androidx.compose.ui.platform.LocalInputModeManager.current
+        LaunchedEffect(Unit) {
+            @OptIn(androidx.compose.ui.ExperimentalComposeUiApi::class)
+            inputMode.requestInputMode(androidx.compose.ui.input.InputMode.Keyboard)
+        }
+    }
+
+    /** The channel card while watching, over a bright stand-in picture to judge readability. */
+    @Composable
+    private fun PlayerCard() {
+        CompositionLocalProvider(LocalNow provides now) {
+            JioTVGoTVTheme(form = FormFactor.Tv) {
+                androidx.compose.foundation.layout.Box(
+                    androidx.compose.ui.Modifier.fillMaxSize().background(
+                        androidx.compose.ui.graphics.Brush.verticalGradient(
+                            listOf(
+                                androidx.compose.ui.graphics.Color(0xFF7EC8F0), androidx.compose.ui.graphics.Color(0xFFBFE3F5),
+                                androidx.compose.ui.graphics.Color(0xFF3F9B3A), androidx.compose.ui.graphics.Color(0xFF2E7D32),
+                            ),
+                        ),
+                    ),
+                ) {
+                    com.fenyx.jtv.ui.player.InfoStrap(
+                        channels[1],
+                        com.fenyx.jtv.ui.components.NowNext(nowShows[1], show("Post-match show", 145, 30), listOf(show("Post-match show", 145, 30))),
+                        now, com.fenyx.jtv.ui.player.TvStrap,
+                        androidx.compose.ui.Modifier.align(androidx.compose.ui.Alignment.BottomCenter)
+                            .padding(horizontal = 48.dp, vertical = 27.dp),
+                    )
+                }
+            }
+        }
+    }
+
+
+    /** Home with "Recent" selected: the 3-across grid of the most watched channels. */
+    @Composable
+    private fun TvRecent() {
+        val more = channels + listOf(
+            Channel("9", "Star Plus HD", "", "Entertainment", "", channelNumber = 150),
+            Channel("10", "Republic TV", "", "News", "", channelNumber = 112),
+            Channel("11", "MTV Beats", "", "Music", "", channelNumber = 701),
+            Channel("12", "Sony Ten 1 HD", "", "Sports", "", channelNumber = 410),
+        )
+        val shows = nowShows + listOf(show("Anupamaa", -5, 30), show("Debate Night", -30, 60), show("Bollywood Hits", -15, 60), show("WWE Raw", -50, 120))
+        CompositionLocalProvider(LocalNow provides now) {
+            JioTVGoTVTheme(form = FormFactor.Tv) {
+                androidx.compose.foundation.layout.Box(
+                    androidx.compose.ui.Modifier.fillMaxSize().background(com.fenyx.jtv.theme.Jtv.colors.bg),
+                ) {
+                    WideHome(
+                        categories = listOf(Category("__RECENT__", "Recent", 12)) + categories, selected = "__RECENT__",
+                        count = 846, onSelect = {}, selectOnFocus = false, onSearch = {}, onGuide = {}, onSettings = {},
+                        movingName = null, movingPos = 0, total = 12,
+                        fullWidthList = true,
+                        list = {
+                            androidx.compose.foundation.lazy.grid.LazyVerticalGrid(
+                                columns = androidx.compose.foundation.lazy.grid.GridCells.Fixed(3),
+                                horizontalArrangement = Arrangement.spacedBy(18.dp),
+                                verticalArrangement = Arrangement.spacedBy(18.dp),
+                                contentPadding = androidx.compose.foundation.layout.PaddingValues(start = 6.dp, end = 6.dp, top = 8.dp, bottom = 16.dp),
+                            ) {
+                                items(more.size) { i ->
+                                    RecentTile(
+                                        more[i], shows[i], now, onClick = {}, onLongClick = {},
+                                        modifier = if (i == 1) Modifier.focusRequester(focus) else Modifier,
+                                    )
+                                }
+                            }
+                        },
+                        preview = {},
+                    )
+                }
+            }
+        }
+        val inputMode = androidx.compose.ui.platform.LocalInputModeManager.current
+        LaunchedEffect(Unit) {
+            @OptIn(androidx.compose.ui.ExperimentalComposeUiApi::class)
+            inputMode.requestInputMode(androidx.compose.ui.input.InputMode.Keyboard)
+        }
+    }
+
+    @Test
+    fun recent() = render("recent", focusText = "x") { TvRecent() }
+
+    @Test
+    fun player() = render("player") { PlayerCard() }
+
+    @Test
+    fun home() = render("home", focusText = "Star Sports 1 HD") { TvHome() }
+
+    private fun render(name: String, focusText: String? = null, content: @Composable () -> Unit) {
+        rule.setContent(content)
+        rule.waitForIdle()
+        if (focusText != null) rule.runOnIdle { focus.requestFocus() }
+        rule.waitForIdle()
+        rule.mainClock.advanceTimeBy(1_000)
+        rule.waitForIdle()
+        val bmp = rule.onRoot().captureToImage().asAndroidBitmap()
+        val dir = File(System.getProperty("previewOut") ?: "build/previews").apply { mkdirs() }
+        File(dir, "$name.png").outputStream().use { bmp.compress(Bitmap.CompressFormat.PNG, 100, it) }
+        println("PREVIEW saved ${File(dir, "$name.png").absolutePath}")
+    }
+}
