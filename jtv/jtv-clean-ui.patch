@@ -5,6 +5,7 @@ import androidx.compose.ui.res.stringResource
 import androidx.compose.foundation.background
 import androidx.compose.foundation.focusGroup
 import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.aspectRatio
 import androidx.compose.foundation.layout.Box
 import androidx.compose.foundation.layout.Column
 import androidx.compose.foundation.layout.Row
@@ -342,3 +343,61 @@ private fun RailItem(
         }
     }
 }
+
+/**
+ * LOCAL CLEAN-UI CHANGE: one big tile in Home's "Recent" grid (3 across, most watched first): a 16:9
+ * logo plate with the channel number in its corner, then name, what's on and progress. Focus = white
+ * card that lifts slightly, like the tvhome launcher's tiles.
+ */
+@Composable
+fun RecentTile(
+    channel: Channel,
+    nowProgram: EpgProgram?,
+    now: Long,
+    onClick: () -> Unit,
+    onLongClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val c = Jtv.colors
+    JtvClickable(
+        onClick = onClick, onLongClick = onLongClick,
+        modifier = modifier.fillMaxWidth(),
+        shape = RoundedCornerShape(16.dp),
+        container = c.s1, focusedContainer = c.inv, focusedScale = 1.04f,
+    ) { focused ->
+        val fg = if (focused) c.invTx else c.tx
+        val fg2 = if (focused) c.invTx.copy(alpha = 0.72f) else c.t2
+        Column(Modifier.fillMaxWidth().padding(10.dp)) {
+            Box(
+                Modifier.fillMaxWidth().aspectRatio(16f / 9f).clip(RoundedCornerShape(11.dp)).background(c.plate),
+                contentAlignment = Alignment.Center,
+            ) {
+                ChannelPlate(channel.logoUrl, 136.dp, 76.dp)
+                if (channel.channelNumber > 0) {
+                    Text(
+                        channel.channelNumber.toString(), style = numberStyle(14.sp), color = c.t2, maxLines = 1,
+                        modifier = Modifier.align(Alignment.TopStart).padding(horizontal = 10.dp, vertical = 8.dp),
+                    )
+                }
+            }
+            Box(Modifier.height(10.dp))
+            Text(
+                channel.name, style = textStyle(16.sp, FontWeight.SemiBold), color = fg, maxLines = 1,
+                overflow = androidx.compose.ui.text.style.TextOverflow.Ellipsis,
+                modifier = Modifier.padding(horizontal = 4.dp),
+            )
+            Text(
+                nowProgram?.title ?: groupLabel(channel.group), style = textStyle(13.sp), color = fg2, maxLines = 1,
+                overflow = androidx.compose.ui.text.style.TextOverflow.Ellipsis,
+                modifier = Modifier.padding(horizontal = 4.dp, vertical = 2.dp),
+            )
+            if (nowProgram != null) {
+                JtvProgress(
+                    nowProgram.progress(now), Modifier.padding(start = 4.dp, end = 4.dp, top = 6.dp, bottom = 2.dp),
+                    color = if (focused) fg else c.t3,
+                    track = if (focused) fg.copy(alpha = 0.22f) else c.line,
+                )
+            }
+        }
+    }
+}
