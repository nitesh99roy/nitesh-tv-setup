diff --git a/android/app/src/main/java/com/fenyx/jtv/data/WatchScores.kt b/android/app/src/main/java/com/fenyx/jtv/data/WatchScores.kt
new file mode 100644
index 0000000..eb92d08
--- /dev/null
+++ b/android/app/src/main/java/com/fenyx/jtv/data/WatchScores.kt
@@ -0,0 +1,45 @@
+package com.fenyx.jtv.data
+
+/**
+ * LOCAL CLEAN-UI CHANGE (not upstream): watch time per channel, so Home's "Recent" can show the most
+ * watched channels instead of only the last ones zapped through.
+ *
+ * A watch session opens when a channel starts playing and closes when you change channel, leave the
+ * player or the TV goes to the background. Sessions under a minute (zapping) don't count; one sitting
+ * counts at most four hours (a TV left on overnight). Scores are seconds, stored as "id:secs,id:secs".
+ */
+internal object WatchScores {
+    const val MIN_MS = 60_000L
+    const val CAP_MS = 4 * 60 * 60_000L
+    private const val KEEP = 100
+
+    fun parse(raw: String?): Map<String, Long> =
+        raw?.split(',')?.mapNotNull { e ->
+            val i = e.lastIndexOf(':')
+            if (i <= 0) return@mapNotNull null
+            val secs = e.substring(i + 1).toLongOrNull() ?: return@mapNotNull null
+            e.substring(0, i) to secs
+        }?.toMap() ?: emptyMap()
+
+    fun format(scores: Map<String, Long>): String =
+        scores.entries.sortedByDescending { it.value }.take(KEEP).joinToString(",") { "${it.key}:${it.value}" }
+
+    fun credit(scores: Map<String, Long>, id: String, elapsedMs: Long): Map<String, Long> =
+        if (elapsedMs < MIN_MS) scores else scores + (id to (scores[id] ?: 0L) + minOf(elapsedMs, CAP_MS) / 1000)
+
+    /** Session "id|startMs" → (id, start), or null. */
+    fun session(raw: String?): Pair<String, Long>? {
+        val i = raw?.lastIndexOf('|') ?: return null
+        if (i <= 0) return null
+        val start = raw.substring(i + 1).toLongOrNull() ?: return null
+        return raw.substring(0, i) to start
+    }
+
+    /** Most watched first; channels never watched long enough keep their recent order after them. */
+    fun mostWatched(scores: Map<String, Long>, recent: List<String>, n: Int = 12): List<String> {
+        val recency = recent.withIndex().associate { it.value to it.index }
+        return (scores.keys + recent).distinct()
+            .sortedWith(compareByDescending<String> { scores[it] ?: 0L }.thenBy { recency[it] ?: Int.MAX_VALUE })
+            .take(n)
+    }
+}
